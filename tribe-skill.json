{
  "name": "bloom-tribe-discovery",
  "version": "1.0.0",
  "description": "Discover and join Bloom tribes — 8 communities for builders, creators, growers, connectors, publishers, analyzers, earners, and thinkers.",
  "homepage": "https://bloomprotocol.ai",
  "author": "Bloom Protocol",
  "license": "MIT",
  "openclaw": {
    "emoji": "🏔️",
    "triggers": [
      "find my tribe",
      "bloom tribe",
      "which tribe am I",
      "join a tribe",
      "show tribes",
      "list tribes",
      "discover tribe",
      "contribute finding",
      "share discovery"
    ],
    "execution": {
      "type": "script",
      "entrypoint": "scripts/tribes.sh",
      "args": []
    },
    "requirements": {
      "node": ">=18.0.0",
      "bins": ["node", "npx"]
    }
  },
  "environment": {
    "required": [
      {
        "key": "BLOOM_API_URL",
        "description": "Bloom Protocol API base URL",
        "default": "https://api.bloomprotocol.ai"
      }
    ],
    "optional": [
      {
        "key": "BLOOM_AUTH_TOKEN",
        "description": "JWT auth token for joining tribes and viewing memberships"
      }
    ]
  },
  "permissions": {
    "network": ["https://api.bloomprotocol.ai"],
    "filesystem": ["read"],
    "execution": ["node", "npx"]
  },
  "installation": {
    "steps": [
      {
        "action": "clone",
        "source": "https://github.com/bloomprotocol/bloom-tribe-skill.git"
      },
      {
        "action": "install_dependencies",
        "command": "npm install"
      },
      {
        "action": "verify",
        "command": "npx tsx src/cli.ts --help"
      }
    ]
  }
}
